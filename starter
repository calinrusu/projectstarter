	exit($message);
}

$basePath = __DIR__;
$appPath = $basePath . '/app';
$publicPath = $basePath . '/public';
$storagePath = $basePath . '/storage';
$bootstrapFile = $appPath . '/bootstrap.php';

function removeDir(string $target): bool {
	$directory = new RecursiveDirectoryIterator($target, FilesystemIterator::SKIP_DOTS);
	$files = new RecursiveIteratorIterator($directory, RecursiveIteratorIterator::CHILD_FIRST);
	foreach ($files as $file) {
		if (is_dir($file)) {
			rmdir($file); 
		} else {
			unlink($file);
		}
	}
	rmdir($target);
	return true;
}

function createApp(string $dir): bool {
	global $appPath;
	global $bootstrapFile;
	if (!is_writable($dir)) {
		return false;
	} else {
		mkdir($dir . '/config');
		mkdir($dir . '/includes');
		mkdir($dir . '/views');
		mkdir($dir . '/views/layouts');
		mkdir($dir . '/views/pages');
		mkdir($dir . '/views/partials');
		$bootstrapCode = '<?php
if (session_status() === PHP_SESSION_NONE) {
    session_start();
}
require_once __DIR__ . \'/config/app.php\';
require_once APP_PATH . \'/config/dbconn.php\';
require_once APP_PATH . \'/includes/functions.php\';
require_once APP_PATH . \'/includes/db.php\';
require_once APP_PATH . \'/includes/csrf.php\';
require_once APP_PATH . \'/includes/validation.php\';';
		file_put_contents($bootstrapFile, $bootstrapCode);
		$configAppCode = '<?php
